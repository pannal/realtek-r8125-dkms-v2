#!/usr/bin/make -f

VERSION := $(shell dpkg-parsechangelog -S Version | sed 's/-[^-]*$$//')
DKMS_SOURCE := usr/src/realtek-r8125-optimized-$(VERSION)
MODULE_SOURCES := $(shell cat debian/module-source-files)

%:
	dh $@

override_dh_install:
	dh_install Makefile $(DKMS_SOURCE)
	dh_install $(MODULE_SOURCES) $(DKMS_SOURCE)/src

override_dh_fixperms:
	dh_fixperms
	find debian/realtek-r8125-optimized-dkms/usr/src -type f -exec chmod 0644 {} +

# dh_dkms installs dkms.conf and generates the sole package lifecycle.
# Module compilation happens at DKMS installation, never at package build time.
override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_test:
override_dh_auto_install:
override_dh_auto_clean:
